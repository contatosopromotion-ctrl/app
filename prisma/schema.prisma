datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  shopifyShopDomain    String?       @unique
  shopifyAccessToken   String?
  shopifyWebhookSecret String?
  lastSyncedAt         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  users         User[]
  influencers   Influencer[]
  orders        Order[]
  payoutBatches PayoutBatch[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("INFLUENCER")
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  influencer   Influencer?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model Influencer {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  displayName    String
  email          String
  couponCode     String
  commissionRate Decimal  @default(0.10)
  pixKey         String?
  bankName       String?
  bankAccount    String?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders          Order[]
  payoutLineItems PayoutLineItem[]

  @@unique([tenantId, couponCode])
  @@index([tenantId])
}

model Order {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  influencerId      String
  influencer        Influencer @relation(fields: [influencerId], references: [id])
  shopifyOrderId    String
  orderNumber       String
  couponCode        String
  customerEmail     String?
  subtotalPrice     Decimal
  totalDiscounts    Decimal  @default(0)
  totalPrice        Decimal
  currency          String   @default("BRL")
  financialStatus   String
  fulfillmentStatus String?
  processedAt       DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, shopifyOrderId])
  @@index([tenantId, influencerId])
  @@index([tenantId, processedAt])
  @@index([couponCode])
}

model PayoutBatch {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      String            @default("DRAFT")
  exportedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lineItems PayoutLineItem[]
}

model PayoutLineItem {
  id             String      @id @default(cuid())
  batchId        String
  batch          PayoutBatch @relation(fields: [batchId], references: [id])
  influencerId   String
  influencer     Influencer  @relation(fields: [influencerId], references: [id])
  orderCount     Int
  totalRevenue   Decimal
  commissionRate Decimal
  commissionOwed Decimal
  createdAt      DateTime    @default(now())

  @@unique([batchId, influencerId])
}
